",\"children\":[[\"$\",\"div\",null,{\"className\":\"md:col-span-4 lg:col-span-5 flex flex-col justify-between \",\"children\":[[\"$\",\"div\",null,{\"className\":\"\",\"children\":[[\"$\",\"$L7\",null,{\"href\":\"/news/মদক-সবনর-ভডও-করত-গয়-পলট-চদবজর-মমলয়-করগর-৪-সবদক\",\"className\":\"group\",\"children\":[\"$\",\"h1\",null,{\"className\":\"text-2xl md:text-3xl xl:text-5xl  text-gray-950 leading-[1.15]\\r\\n\\n                             group-hover:text-primary transition-colors\",\"children\":\"মাদক সেবনের ভিডিও করতে গিয়ে পাল্টা চাঁদাবাজির মামলায় কারাগারে ৪ সাংবাদিক\"}]}],[\"$\",\"p\",null,{\"className\":\"text-gray-600  text-base md:text-2xl leading-relaxed mt-2 md:mt-3 line-clamp-3 md:line-clamp-5\\r\\n\\n \",\"children\":\"টাঙ্গাইলের সখীপুরে মাদক সেবনের ভিডিও ধারণ করতে গিয়ে চাঁদাবাজির মামলায় গ্রেপ্তার হয়েছেন চার সাংবাদিক। শনিবার (১৪ নভেম্বর) দুপুরে আদালতের মাধ্যমে তাঁদের কারাগারে পাঠানো হয়। এ ঘটনায় স্থানীয় গণমাধ্যমকর্মীদের মধ্যে তীব্র ক্ষোভ ও উত্তেজনা বিরাজ করছে।ঘটনার বিবরণে জানা যায়, শুক্রবার রাতে সখীপুর উপজেলার দাড়িয়াপুর ইউনিয়নের দেওবাড়ী এলাকার একটি বাড়িতে কয়েকজন ব্যক্তির গাঁজা সেবনের ভিডিও ধারণ করতে যান ওই চার সাংবাদিক। এ সময় স্থানীয় যুবদল নেতা জাহিদ ও তাঁর সহযোগীরা সাংবাদিকদের আটক করে বাজারে নিয়ে যান। সেখানে উত্তেজিত জনতা জড়ো করে তাঁদের হেনস্তা করা হয়। পরে খবর পেয়ে পুলিশ ঘটনাস্থল থেকে ওই চার সাংবাদিককে উদ্ধার করে থানায় নিয়ে যায়।পরদিন শনিবার সকালে দাড়িয়াপুর ইউনিয়ন বিএনপির যুগ্ম সাধারণ সম্পাদক ফজলুর রহমান...\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-2 pt-4 lg:pt-10 text-base md:text-xl\",\"children\":[[\"$\",\"div\",\"সরদশ\",{\"className\":\"px-3 py-1 bg-gray-200  font-bold text-gray-600\",\"children\":\"সারাদেশ\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"md:col-span-5 lg:col-span-5\",\"children\":[\"$\",\"$L7\",null,{\"href\":\"/news/মদক-সবনর-ভডও-করত-গয়-পলট-চদবজর-মমলয়-করগর-৪-সবদক\",\"className\":\"block relative h-[250px] md:h-full w-full overflow-hidden\",\"children\":[\"$\",\"img\",null,{\"src\":\"https://images.jubotaranews.com/upl