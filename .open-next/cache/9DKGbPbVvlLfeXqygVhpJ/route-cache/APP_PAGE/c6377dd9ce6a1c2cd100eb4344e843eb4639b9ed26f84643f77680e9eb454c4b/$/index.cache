েজিত জনতা জড়ো করে তাঁদের হেনস্তা করা হয়। পরে খবর পেয়ে পুলিশ ঘটনাস্থল থেকে ওই চার সাংবাদিককে উদ্ধার করে থানায় নিয়ে যায়।পরদিন শনিবার সকালে দাড়িয়াপুর ইউনিয়ন বিএনপির যুগ্ম সাধারণ সম্পাদক ফজলুর রহমান...\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-2 pt-4 lg:pt-10 text-base md:text-xl\",\"children\":[[\"$\",\"div\",\"সরদশ\",{\"className\":\"px-3 py-1 bg-gray-200  font-bold text-gray-600\",\"children\":\"সারাদেশ\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"md:col-span-5 lg:col-span-5\",\"children\":[\"$\",\"$L27\",null,{\"href\":\"/news/মদক-সবনর-ভডও-করত-গয়-পলট-চদবজর-মমলয়-করগর-৪-সবদক\",\"className\":\"block relative h-[250px] md:h-full w-full overflow-hidden\",\"children\":[\"$\",\"img\",null,{\"src\":\"https://images.jubotaranews.com/uploads/0e99cfd6c1463c950d277e4967300208.jpg\",\"alt\":\"মাদক সেবনের ভিডিও করতে গিয়ে পাল্টা চাঁদাবাজির মামলায় কারাগারে ৪ সাংবাদিক\",\"sizes\":\"(max-width: 768px) 100vw, (max-width: 1024px) 42vw, 40vw\",\"className\":\"object-cover transition-transform duration-700 hover:scale-105 absolute inset-0 w-full h-full\",\"style\":{\"viewTransitionName\":\"hero-image\"}}]}]}],[\"$\",\"div\",null,{\"className\":\"md:col-span-3 lg:col-span-2\",\"children\":[\"$\",\"$L68\",null,{}]}]]}]}]]}]\n25:[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[1560px] px-3 sm:px-3.5 md:px-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"   \",\"children\":[\"$\",\"div\",null,{\"className\":\"grid md:grid-cols-3 gap-2 md:gap-4\",\"children\":[[\"$\",\"div\",\"6af7533a0112575d67c2a0c5\",{\"className\":\"flex justify-between gap-2 border-b pb-4 cursor-pointer group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex-1\",\"children\":[[\"$\",\"$L27\",null,{\"href\":\"/news/সড়ক-পরবহন-আইন-মবইল-করটর-অভযন-সঘটয়-৪-হজর-টক-জরমন\",\"className\":\"text-gray-600 text-lg md:text-[22px] leading-[24px] md:leading-[26px]\\r\\n\\n                 group-hover:text-primary font-semibold line-clamp-2 \",\"scroll\":true,\"children\":\"সড়ক পরিবহন আইনে মোবাইল কোর